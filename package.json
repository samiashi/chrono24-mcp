{
  "name": "chrono24-mcp",
  "version": "0.4.0",
  "description": "Chrono24 watch-marketplace MCP server - search listings and inspect watch details via a browser-based fetcher that passes Cloudflare",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "chrono24-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22"
  },
  "mcpName": "io.github.samiashi/chrono24-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/samiashi/chrono24-mcp.git"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "chrono24",
    "watches",
    "horology",
    "scraper"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.dev.json",
    "smoke": "tsx scripts/smoke.mjs",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "playwright-core": "^1.62.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
